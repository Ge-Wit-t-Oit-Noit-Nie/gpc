BEGIN_PROGRAMMA:
	ZET_POORT_AAN (POORT=0x01, HSIO=0x00);
	WACHTEN (delay=0x005);
	ZET_POORT_UIT (POORT=0x01, HSIO=0x00);
	WACHTEN (delay=0x005);

	ZET_POORT_AAN (POORT=0x02, HSIO=0x00);
	WACHTEN (delay=0x005);
	ZET_POORT_UIT (POORT=0x02, HSIO=0x00);
	WACHTEN (delay=0x005);

	ZET_POORT_AAN (POORT=0x03, HSIO=0x00);
	WACHTEN (delay=0x005);
	ZET_POORT_UIT (POORT=0x03, HSIO=0x00);
	WACHTEN (delay=0x005);

	BEWAAR_STATUS;
	SPRING (index=0x0000);

PAUZE_PROGRAMMA:
	ZET_POORT_AAN (POORT=0x0F, HSIO=0x00);
	PAUZE;

EINDE_PROGRAMMA:
	BEWAAR_STATUS;
	STOPPEN;