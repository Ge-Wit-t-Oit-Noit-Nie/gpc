BEGIN_PROGRAMMA:
	ZET_POORT_AAN (POORT=0x00, HSIO=0x00);
	ZET_POORT_AAN (POORT=0x01, HSIO=0x00);
	ZET_POORT_AAN (POORT=0x02, HSIO=0x00);
	WACHTEN (delay=10);
	FLIP_POORT (POORT=0x00, HSIO=0x00);
	FLIP_POORT (POORT=0x01, HSIO=0x00);
	FLIP_POORT (POORT=0x02, HSIO=0x00);
	BEWAAR_STATUS;
	SPRING (index=6);

PAUZE_PROGRAMMA:
	ZET_POORT_AAN (POORT=0x0F, HSIO=0x00);
	PAUZE;

EINDE_PROGRAMMA:
	BEWAAR_STATUS;
	STOPPEN;